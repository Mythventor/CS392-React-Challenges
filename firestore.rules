rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function validCourse(course) {
      return course.keys().hasAll(['title', 'term', 'number', 'meets'])
        && course.keys().hasOnly(['title', 'term', 'number', 'meets'])
        && course.title is string && course.title.size() >= 2
        && course.term in ['Fall', 'Winter', 'Spring', 'Summer']
        && course.number is string && course.number.matches('[0-9]+(-[0-9]+)?')
        && course.meets is string
        && (course.meets == '' || course.meets.matches('(M|Tu|W|Th|F|Sa|Su)+ ([01]?[0-9]|2[0-3]):[0-5][0-9]-([01]?[0-9]|2[0-3]):[0-5][0-9]'));
    }
    function validUpdate() {
      let next = request.resource.data;
      let id = next.lastEditedCourseId;
      return id is string
        && next.diff(resource.data).affectedKeys().hasOnly(['courses', 'lastEditedCourseId'])
        && next.courses.keys() == resource.data.courses.keys()
        && id in resource.data.courses
        && next.courses.diff(resource.data.courses).affectedKeys().hasOnly([id])
        && next.courses.diff(resource.data.courses).affectedKeys().size() == 1
        && validCourse(next.courses[id]);
    }
    match /schedules/CS-2018-2019 {
      allow get: if true;
      // Public editing is intentional for this classroom demo.
      allow update: if validUpdate();
      allow list, create, delete: if false;
    }
  }
}
